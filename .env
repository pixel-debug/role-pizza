# Neon/Postgres: cole a URL fornecida pelo provedor, mantendo sslmode=require.
# Use a URL pooled do Neon (hostname com -pooler) para a Vercel.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DB_POOL_MAX=2

# Postgres — your database connection
DATABASE_URL="postgresql://neondb_owner:npg_Xs1vldtRbj7T@ep-red-dust-b6j10dy4.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://neondb_owner:npg_Xs1vldtRbj7T@ep-red-dust-b6j10dy4-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"


# DB_CLIENT e inferido como pg quando DATABASE_URL esta definida.
# Nao use o prefixo VITE_ em variaveis de banco ou credenciais.
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Demo local: remova DATABASE_URL e defina DB_CLIENT=sqlite.
# Oracle local: remova DATABASE_URL e use as variaveis abaixo.
# DB_CLIENT=oracle
# DB_HOST=localhost
# DB_PORT=1521
# DB_SERVICE=FREEPDB1
# DB_USER=pizza
# DB_PASSWORD=YOUR_PASSWORD
